{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Copper Charcoal",
  "author": "Anton Zavalniuk",
  "themes": [
    {
      "name": "Copper Charcoal",
      "appearance": "dark",
      "style": {
        "border": "#2b2b2b",
        "border.focused": "#e5885c",

        "background": "#1a1a1a",
        "elevation.surface.background": "#222222",
        "element.background": "#262626",
        "element.hover": "#333333",
        "element.active": "#404040",

        "text": "#d4d4d4",
        "text.muted": "#888888",
        "text.accent": "#e5885c",

        "status_bar.background": "#141414",
        "title_bar.background": "#141414",
        "tab_bar.background": "#141414",
        "tab.active_background": "#1a1a1a",
        "tab.inactive_background": "#141414",
        "editor.background": "#1a1a1a",
        "editor.active_line.background": "#242424",
        "editor.line_number": "#555555",
        "editor.active_line_number": "#e5885c",

        "error": "#f06292",
        "warning": "#e5885c",
        "info": "#64b5f6",

        "created": "#81c784",
        "modified": "#e5885c",
        "deleted": "#f06292",

        "syntax": {
          "attribute": { "color": "#ffb74d" },
          "boolean": { "color": "#ff8a65" },
          "comment": { "color": "#666666", "font_style": "italic" },
          "comment.doc": { "color": "#888888", "font_style": "italic" },
          "constant": { "color": "#ff8a65" },
          "constructor": { "color": "#ffb74d" },
          "embedded": { "color": "#e5885c" },
          "emphasis": { "color": "#d97749", "font_style": "italic" },
          "emphasis.strong": { "color": "#d97749", "font_weight": 700 },
          "enum": { "color": "#ffb74d" },
          "function": { "color": "#64b5f6", "font_weight": 600 },
          "function.method": { "color": "#64b5f6" },
          "hint": { "color": "#81c784" },
          "keyword": { "color": "#fb4934", "font_weight": 600 },
          "label": { "color": "#e5885c" },
          "link_text": { "color": "#64b5f6", "font_style": "italic" },
          "link_uri": { "color": "#81c784" },
          "number": { "color": "#ff8a65" },
          "operator": { "color": "#d97749" },
          "predictive": { "color": "#555555" },
          "preproc": { "color": "#d97749" },
          "primary": { "color": "#e0e0e0" },
          "property": { "color": "#ffb74d" },
          "punctuation": { "color": "#a0a0a0" },
          "punctuation.bracket": { "color": "#d97749" },
          "punctuation.delimiter": { "color": "#a0a0a0" },
          "punctuation.special": { "color": "#d97749" },
          "string": { "color": "#81c784" },
          "string.escape": { "color": "#d97749" },
          "string.regex": { "color": "#81c784" },
          "string.special": { "color": "#d97749" },
          "string.special.symbol": { "color": "#ff8a65" },
          "tag": { "color": "#fb4934" },
          "type": { "color": "#ffb74d" },
          "variable": { "color": "#e0e0e0" },
          "variable.special": { "color": "#d97749" }
        }
      }
    }
  ]
}
